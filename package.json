{
  "name": "asl-language-server",
  "version": "0.0.0",
  "private": true,
  "description": "Language server for Amazon States Language that understands Terraform templatefile() and SAM DefinitionSubstitutions",
  "license": "MIT",
  "type": "module",
  "bin": {
    "asl-language-server": "dist/asl-language-server.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "amazon-states-language-service": "^1.16.1",
    "js-yaml": "^4.3.2",
    "vscode-languageserver": "^10.1.2",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
